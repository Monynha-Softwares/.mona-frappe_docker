# ERPNext Docker Local Environment for localhost testing
ERPNEXT_VERSION=v15.88.0

# Database settings
DB_PASSWORD=admin
DB_PASSWORD_SECRETS_FILE=
DB_HOST=db
DB_PORT=3306

# Redis settings
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# HTTPS/SSL (use a dummy email for local)
LETSENCRYPT_EMAIL=local@example.com

# Site/domain config
FRAPPE_SITE_NAME_HEADER=127.0.0.1
HTTP_PUBLISH_PORT=8080
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Sites for Let's Encrypt (use localhost)
SITES=`127.0.0.1`