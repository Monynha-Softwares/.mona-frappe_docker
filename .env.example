###############################################
#  ERPNext / Frappe - Boteco Pro (.env.example)
#  Ambiente de deploy via Coolify (self-hosted)
###############################################

##########################
# VERSÕES DAS IMAGENS
##########################
FRAPPE_TAG=v15.88.0
MARIADB_TAG=10.6
REDIS_TAG=6.2-alpine

##########################
# DADOS DO SITE / DOMÍNIO
##########################
# Domínio principal (use o mesmo configurado no Coolify)
PRIMARY_SITE=erp.boteco.pt

# Nome do upstream do backend e websocket (mantém padrão interno)
BACKEND_UPSTREAM=backend:8000
SOCKETIO_UPSTREAM=websocket:9000

##########################
# CREDENCIAIS / SENHAS
##########################
# Senha do root do banco (usada em MariaDB e ERPNext)
DB_ROOT_PASSWORD=supersecretroot

# Senha do usuário Administrator no ERPNext
ADMIN_PASSWORD=supersecretadmin

##########################
# BANCO DE DADOS
##########################
DB_HOST=db
DB_PORT=3306

##########################
# REDIS
##########################
REDIS_CACHE_HOST=redis-cache:6379
REDIS_QUEUE_HOST=redis-queue:6379
SOCKETIO_PORT=9000

##########################
# REDE E SERVIÇOS
##########################
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

##########################
# COOLIFY / DEPLOY
##########################
# (Opcional) prefixo usado para identificação do projeto
COMPOSE_PROJECT_NAME=boteco

##########################
# OPCIONAIS / CUSTOMIZAÇÃO
##########################
# Pode mudar se quiser definir porta externa manualmente (fora do Coolify)
# FRONTEND_PORT=8080
